# Actual .env is created ON THE SERVER by scripts/init-env.sh; never commit it.
DOMAIN=logicpulse.ru
SERVER_IP=185.125.218.116
LETSENCRYPT_EMAIL=replace@example.com
POSTGRES_DB=logicpulse
POSTGRES_USER=logicpulse_admin
POSTGRES_PASSWORD=GENERATED_ON_SERVER
PGADMIN_DEFAULT_EMAIL=replace@example.com
PGADMIN_DEFAULT_PASSWORD=GENERATED_ON_SERVER
